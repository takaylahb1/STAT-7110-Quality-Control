   "outputs": [],
   "source": [
    "## Q4 Code ##"
   ] library(readxl)
A1 <- read_excel("RavisComics_ShipmentCondition_PhaseI.xlsx")
names(A1) <- c("week", "n", "d")   # TotalComics, NumberNonconforming

phase1_p <- function(df) {
  removed <- c(); iter <- 0
  repeat {
    iter <- iter + 1
    pbar <- sum(df$d) / sum(df$n)
    se   <- sqrt(pbar * (1 - pbar) / df$n)
    df$p   <- df$d / df$n
    df$UCL <- pbar + 3 * se
    df$LCL <- pmax(0, pbar - 3 * se)
    df$ooc <- df$p > df$UCL | df$p < df$LCL

    plot(df$week, df$p, type = "b", pch = 19,
         ylim = range(df$p, df$UCL, df$LCL),
         xlab = "Week", ylab = "Proportion nonconforming",
         main = paste("Phase I p chart - iteration", iter))
    lines(df$week, df$UCL, type = "s", col = "red", lty = 2)
    lines(df$week, df$LCL, type = "s", col = "red", lty = 2)
    abline(h = pbar, col = "blue")
    points(df$week[df$ooc], df$p[df$ooc], col = "red", pch = 19, cex = 1.5)

    cat("Iteration", iter, "- pbar =", round(pbar, 4),
        "- OOC weeks:", df$week[df$ooc], "\n")
    if (!any(df$ooc)) break
    removed <- c(removed, df$week[df$ooc])
    df <- df[!df$ooc, ]
  }
  list(data = df, pbar = pbar, removed = removed)
}

res_p <- phase1_p(A1)
res_p$removed
res_p$pbar
