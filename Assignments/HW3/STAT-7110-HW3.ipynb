  },C <- read_excel("RavisComics_BackIssueDefectCounts.xlsx")
names(C) <- c("week", "boxes", "c")      # BoxesInspected, NumberOfDefects

phase1_u <- function(df) {
  removed <- c(); iter <- 0
  repeat {
    iter <- iter + 1
    ubar <- sum(df$c) / sum(df$boxes)
    df$u   <- df$c / df$boxes
    df$UCL <- ubar + 3 * sqrt(ubar / df$boxes)
    df$LCL <- pmax(0, ubar - 3 * sqrt(ubar / df$boxes))
    df$ooc <- df$u > df$UCL | df$u < df$LCL

    plot(df$week, df$u, type = "b", pch = 19,
         ylim = range(df$u, df$UCL, df$LCL),
         xlab = "Week", ylab = "Defects per box",
         main = paste("u chart - iteration", iter))
    lines(df$week, df$UCL, type = "s", col = "red", lty = 2)
    lines(df$week, df$LCL, type = "s", col = "red", lty = 2)
    abline(h = ubar, col = "blue")
    points(df$week[df$ooc], df$u[df$ooc], col = "red", pch = 19, cex = 1.5)

    cat("Iteration", iter, "- ubar =", round(ubar, 4),
        "- OOC weeks:", df$week[df$ooc], "\n")
    if (!any(df$ooc)) break
    removed <- c(removed, df$week[df$ooc])
    df <- df[!df$ooc, ]
  }
  list(data = df, ubar = ubar, removed = removed)
}

res_u <- phase1_u(C)
res_u$removed
res_u$ubar
