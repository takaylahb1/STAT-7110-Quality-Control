  },B <- read_excel("RavisComics_NewReleaseDefectCounts.xlsx")
names(B) <- c("week", "boxes", "c")      # BoxesInspected (always 5), NumberOfDefects

phase1_c <- function(df) {
  removed <- c(); iter <- 0
  repeat {
    iter <- iter + 1
    cbar <- mean(df$c)
    UCL  <- cbar + 3 * sqrt(cbar)
    LCL  <- max(0, cbar - 3 * sqrt(cbar))
    df$ooc <- df$c > UCL | df$c < LCL

    plot(df$week, df$c, type = "b", pch = 19,
         ylim = range(df$c, UCL, LCL),
         xlab = "Week", ylab = "Defects (5 boxes)",
         main = paste("c chart - iteration", iter))
    abline(h = c(LCL, cbar, UCL), col = c("red", "blue", "red"), lty = c(2, 1, 2))
    points(df$week[df$ooc], df$c[df$ooc], col = "red", pch = 19, cex = 1.5)

    cat("Iteration", iter, "- cbar =", round(cbar, 3),
        "- OOC weeks:", df$week[df$ooc], "\n")
    if (!any(df$ooc)) break
    removed <- c(removed, df$week[df$ooc])
    df <- df[!df$ooc, ]
  }
  list(data = df, cbar = cbar, UCL = UCL, LCL = LCL, removed = removed)
}

res_c <- phase1_c(B)
res_c$removed
