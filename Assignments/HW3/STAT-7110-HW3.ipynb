    "### Q5: Repeat the analysis in Q4, this time constructing an $np$ chart on the same data. Do your conclusions about which week(s) are out of control change? Which chart do you think would be easier to explain to the distributor's account representative, and why?"
   ]
  },
    "## Q5 Code ##"
   ]
  },phase1_np <- function(df) {
  removed <- c(); iter <- 0
  repeat {
    iter <- iter + 1
    pbar <- sum(df$d) / sum(df$n)
    CL   <- df$n * pbar
    se   <- sqrt(df$n * pbar * (1 - pbar))
    df$UCL <- CL + 3 * se
    df$LCL <- pmax(0, CL - 3 * se)
    df$ooc <- df$d > df$UCL | df$d < df$LCL

    plot(df$week, df$d, type = "b", pch = 19,
         ylim = range(df$d, df$UCL, df$LCL),
         xlab = "Week", ylab = "Number nonconforming",
         main = paste("Phase I np chart - iteration", iter))
    lines(df$week, df$UCL, type = "s", col = "red", lty = 2)
    lines(df$week, df$LCL, type = "s", col = "red", lty = 2)
    lines(df$week, CL, type = "s", col = "blue")
    points(df$week[df$ooc], df$d[df$ooc], col = "red", pch = 19, cex = 1.5)

    cat("Iteration", iter, "- pbar =", round(pbar, 4),
        "- OOC weeks:", df$week[df$ooc], "\n")
    if (!any(df$ooc)) break
    removed <- c(removed, df$week[df$ooc])
    df <- df[!df$ooc, ]
  }
  list(data = df, pbar = pbar, removed = removed)
}

res_np <- phase1_np(A1)
res_np$removed
setequal(res_p$removed, res_np$removed)   # TRUE = same conclusion as the p chart
