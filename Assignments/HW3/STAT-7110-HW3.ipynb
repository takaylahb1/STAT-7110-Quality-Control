  },pbar <- res_p$pbar
clean <- res_p$data

cat("Center line (p-bar):", round(pbar, 4), "\n")

lim <- function(n) c(n   = n,
                     LCL = max(0, pbar - 3 * sqrt(pbar * (1 - pbar) / n)),
                     UCL = pbar + 3 * sqrt(pbar * (1 - pbar) / n))

round(rbind(average_n = lim(mean(clean$n)),
            smallest_n = lim(min(clean$n)),
            largest_n  = lim(max(clean$n))), 4)
