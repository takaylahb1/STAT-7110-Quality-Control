# Calculate weekly subgroup means
phase1_means <- sapply(phase1, rowMeans)

# Sample mean vector
mean_vector <- colMeans(phase1_means)
print(round(mean_vector, 4))

# Sample variance-covariance matrix
cov_matrix <- cov(phase1_means)
print(round(cov_matrix, 4))

# Correlation matrix
print(round(cor(phase1_means), 3))

