library(qcc)

phase1 <- read_excel("FilamentDiameter_PhaseI.xlsx")
phase2 <- read_excel("FilamentDiameter_PhaseII.xlsx")

phase1_final <- phase1[-c(12,19), ]

data_phase1 <- as.matrix(phase1_final[,2:6])
data_phase2 <- as.matrix(phase2[,2:6])

xbar_phase1 <- qcc(
  data_phase1,
  type = "xbar",
  plot = FALSE
)

qcc(
  data_phase2,
  type = "xbar",
  center = xbar_phase1$center,
  limits = xbar_phase1$limits,
  newdata = data_phase2
)

